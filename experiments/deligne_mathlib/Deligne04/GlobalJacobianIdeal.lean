import Deligne04.ConicJacobian
import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic

/-!
# DEL-13: a global Bézout certificate for the conic Jacobian ideal

For F(X,Y)=XY+aX+bY+c over a field K, the true multivariate
derivatives are F_X=Y+a and F_Y=X+b (proved in DEL-12).

The characteristic-free Bézout identity

    F - F_Y * F_X = C (c-a*b)

holds as an equation in the polynomial ring K[X,Y].

When c-a*b != 0, this identity gives an explicit expression for 1
in the ideal generated by F, F_X and F_Y. The Jacobian ideal is
therefore the unit ideal, a stronger algebraic certificate than
the earlier pointwise nonvanishing proof.

This module does not invoke a scheme-level Jacobian criterion. It
isolates the exact ideal identity needed for that future step.
-/

namespace Deligne13

/-- An identity in the genuine multivariate polynomial ring:
F - F_Y*F_X is the constant discriminant c-a*b. -/
theorem conic_bezout_identity
    {K : Type*} [CommRing K] (a b c : K) :
    Deligne12.conicPolynomial K a b c -
      MvPolynomial.pderiv true (Deligne12.conicPolynomial K a b c) *
      MvPolynomial.pderiv false (Deligne12.conicPolynomial K a b c) =
        MvPolynomial.C (c - a * b) := by
  rw [Deligne12.pderiv_conic_x, Deligne12.pderiv_conic_y]
  simp only [Deligne12.conicPolynomial, map_sub, map_mul]
  ring

/-- The ideal generated by the conic equation and its actual
x and y partial derivatives. -/
noncomputable def conicJacobianIdeal
    (K : Type*) [Field K] (a b c : K) :
    Ideal (MvPolynomial Bool K) :=
  Ideal.span ({
    Deligne12.conicPolynomial K a b c,
    MvPolynomial.pderiv false (Deligne12.conicPolynomial K a b c),
    MvPolynomial.pderiv true (Deligne12.conicPolynomial K a b c)
  } : Set (MvPolynomial Bool K))

/-- The actual defining polynomial belongs to its Jacobian ideal. -/
theorem conic_in_jacobian_ideal
    {K : Type*} [Field K] (a b c : K) :
    Deligne12.conicPolynomial K a b c ∈
      conicJacobianIdeal K a b c := by
  apply Ideal.subset_span
  simp [conicJacobianIdeal]

/-- The true x partial derivative belongs to the Jacobian ideal. -/
theorem pderiv_x_in_jacobian_ideal
    {K : Type*} [Field K] (a b c : K) :
    MvPolynomial.pderiv false (Deligne12.conicPolynomial K a b c)
      ∈ conicJacobianIdeal K a b c := by
  apply Ideal.subset_span
  simp [conicJacobianIdeal]

/-- The true y partial derivative belongs to the Jacobian ideal. -/
theorem pderiv_y_in_jacobian_ideal
    {K : Type*} [Field K] (a b c : K) :
    MvPolynomial.pderiv true (Deligne12.conicPolynomial K a b c)
      ∈ conicJacobianIdeal K a b c := by
  apply Ideal.subset_span
  simp [conicJacobianIdeal]

/-- The discriminant as a constant polynomial lies in the ideal
generated by the equation and both partial derivatives. -/
theorem conic_discriminant_mem_jacobian_ideal
    {K : Type*} [Field K] (a b c : K) :
    (MvPolynomial.C (c - a * b) : MvPolynomial Bool K)
      ∈ conicJacobianIdeal K a b c := by
  let J := conicJacobianIdeal K a b c
  have hF : Deligne12.conicPolynomial K a b c ∈ J :=
    conic_in_jacobian_ideal a b c
  have hX :
      MvPolynomial.pderiv false (Deligne12.conicPolynomial K a b c) ∈ J :=
    pderiv_x_in_jacobian_ideal a b c
  have hprod :
      MvPolynomial.pderiv true (Deligne12.conicPolynomial K a b c) *
      MvPolynomial.pderiv false (Deligne12.conicPolynomial K a b c) ∈ J :=
    J.mul_mem_left _ hX
  rw [← conic_bezout_identity]
  exact J.sub_mem hF hprod

/-- When c-a*b is a unit (automatically true off the
discriminant in a field), the global Jacobian ideal equals top.
This produces a concrete polynomial Bézout certificate for 1. -/
theorem conic_jacobian_ideal_eq_top
    {K : Type*} [Field K] (a b c : K)
    (hdelta : c ≠ a * b) :
    conicJacobianIdeal K a b c = ⊤ := by
  let J := conicJacobianIdeal K a b c
  have hnz : c - a * b ≠ 0 := sub_ne_zero.mpr hdelta
  have hconst :
      (MvPolynomial.C (c - a * b) : MvPolynomial Bool K) ∈ J :=
    conic_discriminant_mem_jacobian_ideal a b c
  have hmul :
      (MvPolynomial.C ((c - a * b)⁻¹) *
        MvPolynomial.C (c - a * b) : MvPolynomial Bool K) ∈ J :=
    J.mul_mem_left _ hconst
  have hvalue :
      (MvPolynomial.C ((c - a * b)⁻¹) *
        MvPolynomial.C (c - a * b) : MvPolynomial Bool K) = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hnz, map_one]
  have hone : (1 : MvPolynomial Bool K) ∈ J := by
    rw [hvalue] at hmul
    exact hmul
  exact (Ideal.eq_top_iff_one J).mpr hone

#print axioms conic_bezout_identity
#print axioms conic_in_jacobian_ideal
#print axioms pderiv_x_in_jacobian_ideal
#print axioms pderiv_y_in_jacobian_ideal
#print axioms conic_discriminant_mem_jacobian_ideal
#print axioms conic_jacobian_ideal_eq_top

end Deligne13
