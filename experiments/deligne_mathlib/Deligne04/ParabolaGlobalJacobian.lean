import Deligne04.ParabolaProductBadLocus
import Deligne04.EffectiveFiniteOpen
import Mathlib.RingTheory.Ideal.Span
import Mathlib.Tactic

/-!
# DEL-18: global Jacobian unit ideal and effective finite-field parameter selection

DEL-17 proved an explicit global Bézout identity for the section
G=alpha*x^2+x*y+beta*y^2+p*x+q*y+c on the actual embedded
parabola product U², with U={(x,y):y=x²}.

This module proves C(E) belongs to the ideal (G,G_x,G_y), where
E=(4*alpha*beta-1)*c-alpha*q²-beta*p²+p*q. Over any field, E≠0
implies the entire polynomial Jacobian ideal is top.

It then feeds the *actual* parameter MvPolynomial from DEL-17 into
DEL-10's finite-field rational-point theorem, leaving the Katz-good
principal polynomial and its quantitative degree bound explicit.

The result concerns the embedded parabola product, not the general
Bertini or Katz theorem on arbitrary U^k.
-/

namespace Deligne18

/-- The Jacobian ideal is generated by the genuine polynomial
section and both Mathlib formal partial derivatives. -/
noncomputable def parabolaJacobianIdeal
    (K : Type*) [Field K] (alpha beta p q c : K) :
    Ideal (MvPolynomial Bool K) :=
  Ideal.span ({
    Deligne17.parabolaSection K alpha beta p q c,
    MvPolynomial.pderiv false
      (Deligne17.parabolaSection K alpha beta p q c),
    MvPolynomial.pderiv true
      (Deligne17.parabolaSection K alpha beta p q c)
  } : Set (MvPolynomial Bool K))

theorem section_mem_jacobian
    {K : Type*} [Field K] (alpha beta p q c : K) :
    Deligne17.parabolaSection K alpha beta p q c ∈
      parabolaJacobianIdeal K alpha beta p q c := by
  apply Ideal.subset_span
  simp [parabolaJacobianIdeal]

theorem pderiv_x_mem_jacobian
    {K : Type*} [Field K] (alpha beta p q c : K) :
    MvPolynomial.pderiv false
      (Deligne17.parabolaSection K alpha beta p q c) ∈
        parabolaJacobianIdeal K alpha beta p q c := by
  apply Ideal.subset_span
  simp [parabolaJacobianIdeal]

theorem pderiv_y_mem_jacobian
    {K : Type*} [Field K] (alpha beta p q c : K) :
    MvPolynomial.pderiv true
      (Deligne17.parabolaSection K alpha beta p q c) ∈
        parabolaJacobianIdeal K alpha beta p q c := by
  apply Ideal.subset_span
  simp [parabolaJacobianIdeal]

/-- The characteristic-free DEL-17 Bézout identity establishes
actual ideal membership, without inspecting only field-valued
evaluation functions. -/
theorem eliminant_mem_jacobian
    {K : Type*} [Field K] (alpha beta p q c : K) :
    (MvPolynomial.C (Deligne17.eliminant alpha beta p q c) :
      MvPolynomial Bool K) ∈
        parabolaJacobianIdeal K alpha beta p q c := by
  let J := parabolaJacobianIdeal K alpha beta p q c
  let G := Deligne17.parabolaSection K alpha beta p q c
  let Gx := MvPolynomial.pderiv false G
  let Gy := MvPolynomial.pderiv true G
  have hG : G ∈ J := section_mem_jacobian alpha beta p q c
  have hGx : Gx ∈ J := pderiv_x_mem_jacobian alpha beta p q c
  have hGy : Gy ∈ J := pderiv_y_mem_jacobian alpha beta p q c
  have hGx2 : Gx ^ 2 ∈ J := by
    simpa only [pow_two] using (J.mul_mem_left Gx hGx)
  have hGy2 : Gy ^ 2 ∈ J := by
    simpa only [pow_two] using (J.mul_mem_left Gy hGy)
  have h1 :
      MvPolynomial.C (4 * alpha * beta - 1) * G ∈ J :=
    J.mul_mem_left _ hG
  have h2 : MvPolynomial.C alpha * Gy ^ 2 ∈ J :=
    J.mul_mem_left _ hGy2
  have h3 : MvPolynomial.C beta * Gx ^ 2 ∈ J :=
    J.mul_mem_left _ hGx2
  have h4 : Gx * Gy ∈ J := J.mul_mem_left Gx hGy
  rw [Deligne17.parabola_bezout_identity]
  exact J.add_mem (J.sub_mem (J.sub_mem h1 h2) h3) h4

/-- The global Jacobian ideal is the whole polynomial ring on
the nonvanishing principal open D(E), over any field. -/
theorem jacobian_top_of_eliminant_nonzero
    {K : Type*} [Field K] (alpha beta p q c : K)
    (hE : Deligne17.eliminant alpha beta p q c ≠ 0) :
    parabolaJacobianIdeal K alpha beta p q c = ⊤ := by
  let J := parabolaJacobianIdeal K alpha beta p q c
  have hconst :
      (MvPolynomial.C (Deligne17.eliminant alpha beta p q c) :
        MvPolynomial Bool K) ∈ J :=
    eliminant_mem_jacobian alpha beta p q c
  have hmul :
      (MvPolynomial.C (Deligne17.eliminant alpha beta p q c)⁻¹ *
        MvPolynomial.C (Deligne17.eliminant alpha beta p q c) :
          MvPolynomial Bool K) ∈ J :=
    J.mul_mem_left _ hconst
  have hvalue :
      (MvPolynomial.C (Deligne17.eliminant alpha beta p q c)⁻¹ *
        MvPolynomial.C (Deligne17.eliminant alpha beta p q c) :
          MvPolynomial Bool K) = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hE, map_one]
  rw [hvalue] at hmul
  exact (Ideal.eq_top_iff_one J).mpr hmul

/-- Nonzero E excludes every simultaneous zero of G and both
actual formal partial derivatives. -/
theorem no_critical_of_eliminant_nonzero
    {K : Type*} [Field K] (alpha beta p q c : K)
    (hE : Deligne17.eliminant alpha beta p q c ≠ 0) :
    ∀ u : Bool → K,
      MvPolynomial.eval u
        (Deligne17.parabolaSection K alpha beta p q c) = 0 →
      MvPolynomial.eval u
        (MvPolynomial.pderiv false
          (Deligne17.parabolaSection K alpha beta p q c)) ≠ 0 ∨
      MvPolynomial.eval u
        (MvPolynomial.pderiv true
          (Deligne17.parabolaSection K alpha beta p q c)) ≠ 0 := by
  intro u hG
  by_contra h
  push_neg at h
  exact hE (Deligne17.critical_implies_eliminant_zero
    alpha beta p q c u hG h.1 h.2)

/-- The genuine five-parameter polynomial can be intersected
with a *separately supplied* Katz-good principal-open polynomial.
The coordinatewise combined degree is an explicit hypothesis. -/
theorem exists_regular_and_katz_good_parameter
    {K : Type*} [Field K] [Fintype K]
    (L : MvPolynomial (Fin 5) K)
    (hL : L ≠ 0)
    (hbudget : ∀ i : Fin 5,
      (Deligne17.badParameterPolynomial K).degreeOf i + L.degreeOf i <
        Fintype.card K) :
    ∃ t : Fin 5 → K,
      (∀ u : Bool → K,
        MvPolynomial.eval u
          (Deligne17.parabolaSection K (t 0) (t 1) (t 2) (t 3) (t 4)) = 0 →
        MvPolynomial.eval u
          (MvPolynomial.pderiv false
            (Deligne17.parabolaSection K
              (t 0) (t 1) (t 2) (t 3) (t 4))) ≠ 0 ∨
        MvPolynomial.eval u
          (MvPolynomial.pderiv true
            (Deligne17.parabolaSection K
              (t 0) (t 1) (t 2) (t 3) (t 4))) ≠ 0) ∧
      MvPolynomial.eval t L ≠ 0 := by
  obtain ⟨t, hEval, hLval⟩ :=
    Deligne10.exists_point_in_two_good_opens
      (Deligne17.badParameterPolynomial K) L
      Deligne17.badParameterPolynomial_ne_zero hL hbudget
  refine ⟨t, ?_, hLval⟩
  have hpoint :
      Deligne17.parameterPoint (t 0) (t 1) (t 2) (t 3) (t 4) = t := by
    funext i
    fin_cases i <;> simp [Deligne17.parameterPoint]
  have hE : Deligne17.eliminant (t 0) (t 1) (t 2) (t 3) (t 4) ≠ 0 := by
    intro hz
    have hbad :
        MvPolynomial.eval
          (Deligne17.parameterPoint (t 0) (t 1) (t 2) (t 3) (t 4))
          (Deligne17.badParameterPolynomial K) = 0 := by
      rw [Deligne17.eval_badParameterPolynomial]
      exact hz
    rw [hpoint] at hbad
    exact hEval hbad
  exact no_critical_of_eliminant_nonzero
    (t 0) (t 1) (t 2) (t 3) (t 4) hE

