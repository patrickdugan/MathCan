#print axioms pderiv_x_mem_jacobian
#print axioms pderiv_y_mem_jacobian
#print axioms eliminant_mem_jacobian
#print axioms jacobian_top_of_eliminant_nonzero
#print axioms no_critical_of_eliminant_nonzero
#print axioms exists_regular_and_katz_good_parameter

end Deligne18
