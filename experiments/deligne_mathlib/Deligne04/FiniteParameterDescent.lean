import Deligne04.FixedCoefficientChart
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.FieldTheory.IntermediateField.Algebraic
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.FieldTheory.Finiteness
import Mathlib.RingTheory.Finiteness.Cardinality
import Mathlib.Tactic

/-!
# DEL-09: actual finite-extension descent of algebraic parameters

A good hyperplane over the algebraic closure of a finite field is
described by FINITELY MANY algebraic coordinates. Adjoining all those
coordinates to the base field gives a finite field extension.

This is a genuine theorem of intermediate fields, rather than an
experiment restricted to F4/F9/F25. The theorem does NOT construct the
good Bertini/Katz open or a point of that open; those are the geometric
inputs. It proves the field of definition of ANY FINITE coordinate tuple
in an algebraic extension.
-/

namespace Deligne09

universe u v

/-- Adjoining finitely many elements of an algebraic extension of a
finite field yields a finite field. This gives an explicit field of
definition for any chosen tuple of generic hyperplane parameters. -/
theorem finite_parameter_field
    {F : Type u} [Field F] [Finite F]
    {E : Type v} [Field E] [Algebra F E]
    [Algebra.IsAlgebraic F E] (s : Finset E) :
    Finite (IntermediateField.adjoin F (s : Set E)) := by
  haveI : Finite (s : Set E) := (Finset.finite_toSet s).to_subtype
  haveI : Algebra.EssFiniteType F
      (IntermediateField.adjoin F (s : Set E)) := inferInstance
  haveI : Algebra.IsAlgebraic F
      (IntermediateField.adjoin F (s : Set E)) := inferInstance
  haveI : Module.Finite F
      (IntermediateField.adjoin F (s : Set E)) :=
    Algebra.finite_of_essFiniteType_of_isAlgebraic
  exact Module.finite_of_finite F

/-- A finite list of hyperplane coefficients over an algebraic
extension always lies in a common finite extension of F. -/
theorem finite_tuple_parameter_field
    {F : Type u} [Field F] [Finite F]
    {E : Type v} [Field E] [Algebra F E]
    [Algebra.IsAlgebraic F E] {n : ℕ} (a : Fin n → E) :
    Finite (IntermediateField.adjoin F (Set.range a)) := by
  haveI : Finite (Set.range a) := (Set.finite_range a).to_subtype
  haveI : Algebra.EssFiniteType F
      (IntermediateField.adjoin F (Set.range a)) := inferInstance
  haveI : Algebra.IsAlgebraic F
      (IntermediateField.adjoin F (Set.range a)) := inferInstance
  haveI : Module.Finite F
      (IntermediateField.adjoin F (Set.range a)) :=
    Algebra.finite_of_essFiniteType_of_isAlgebraic
  exact Module.finite_of_finite F

/-- Every coordinate belongs to that same finite field of definition. -/
theorem parameter_mem_common_extension
    {F : Type u} [Field F]
    {E : Type v} [Field E] [Algebra F E]
    {n : ℕ} (a : Fin n → E) (i : Fin n) :
    a i ∈ IntermediateField.adjoin F (Set.range a) :=
  (IntermediateField.subset_adjoin F (Set.range a)) (Set.mem_range_self i)

/-- In particular the chosen polynomial equation remains defined
over the finite extension generated by all its coefficients. -/
theorem polynomial_coefficients_in_common_extension
    {F : Type u} [Field F]
    {E : Type v} [Field E] [Algebra F E]
    {n : ℕ} (coeff : Fin n → E) :
    ∀ i : Fin n, coeff i ∈
      IntermediateField.adjoin F (Set.range coeff) := by
  intro i
  exact parameter_mem_common_extension coeff i

/-- A dense Bertini open, a dense weak-Lefschetz open and a nonempty
open fixed-coefficient chart admit one common geometric parameter whose
finitely many coordinates descend to an actual finite intermediate field.

The *density and openness* hypotheses must be supplied for the actual
hyperplane parameter scheme. The descent of its selected point is proved
from algebraicity of the field extension and finite generation. -/
theorem exists_good_parameter_over_finite_extension
    {F : Type u} [Field F] [Finite F]
    {E : Type v} [Field E] [Algebra F E]
    [Algebra.IsAlgebraic F E] {n : ℕ}
    [TopologicalSpace (Fin n → E)]
    (bertini lefschetz chart : Set (Fin n → E))
    (hb : Dense bertini) (hl : Dense lefschetz)
    (hob : IsOpen bertini) (hoc : IsOpen chart)
    (hnc : chart.Nonempty) :
    ∃ parameters : Fin n → E,
      parameters ∈ bertini ∧ parameters ∈ lefschetz ∧
        parameters ∈ chart ∧
        ∃ K : IntermediateField F E, Finite K ∧
          ∀ i : Fin n, parameters i ∈ K := by
  obtain ⟨parameters, hB, hL, hC⟩ :=
    Deligne08.good_hyperplane_in_fixed_chart
      bertini lefschetz chart hb hl hob hoc hnc
  refine ⟨parameters, hB, hL, hC,
    IntermediateField.adjoin F (Set.range parameters),
    finite_tuple_parameter_field parameters, ?_⟩
  intro i
  exact parameter_mem_common_extension parameters i

#print axioms exists_good_parameter_over_finite_extension

/-- The finite common field of definition has exactly q^e
elements, where q is the cardinality of the original finite field
and e is the vector-space dimension of the generated extension.
The degree depends on the chosen coefficient tuple. -/
theorem finite_tuple_extension_cardinality
    {F : Type u} [Field F] [Finite F]
    {E : Type v} [Field E] [Algebra F E]
    [Algebra.IsAlgebraic F E] {n : ℕ} (a : Fin n → E) :
    ∃ e : ℕ,
      Nat.card (IntermediateField.adjoin F (Set.range a)) =
        Nat.card F ^ e := by
  haveI : Finite (Set.range a) := (Set.finite_range a).to_subtype
  haveI : Algebra.EssFiniteType F
      (IntermediateField.adjoin F (Set.range a)) := inferInstance
  haveI : Algebra.IsAlgebraic F
      (IntermediateField.adjoin F (Set.range a)) := inferInstance
  haveI : Module.Finite F
      (IntermediateField.adjoin F (Set.range a)) :=
    Algebra.finite_of_essFiniteType_of_isAlgebraic
  exact ⟨Module.finrank F
    (IntermediateField.adjoin F (Set.range a)),
    Module.natCard_eq_pow_finrank⟩

#print axioms finite_tuple_extension_cardinality

#print axioms finite_parameter_field
#print axioms finite_tuple_parameter_field
#print axioms parameter_mem_common_extension
#print axioms polynomial_coefficients_in_common_extension

end Deligne09
