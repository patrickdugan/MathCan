import Deligne04.KahlerCoordinateNaturality
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.Algebra.Module.Submodule.Equiv
import Mathlib.Tactic

/-!
# DEL-21D: duality of the actual Jacobian conormal presentation

For the genuine quotient presentation of an embedded product
U^k, DEL-16 supplies the lifted polynomial generators
g_t ∈ K[z_i] and DEL-20 supplies the Jacobian-kernel tangent.

At a K-point u, the conormal relation vectors are the
actual derivatives (eval_u (pderiv_i g_t))_i ∈ K^(ks).
Take their linear span R_u and the presented cotangent
fiber K^(ks)/R_u.

The central theorem is a canonical K-linear equivalence
  Dual_K (K^(ks)/R_u) ≃ₗ[K] Deligne20.jacobianTangent f u.
Its proof uses Mathlib's true quotient-dual equivalence
and the finite-coordinate linear duality equivalence,
with a kernel-checked correspondence of the annihilator
condition and actual polynomial Jacobian tangency.

The relation space uses the full defining-equation list,
including nilpotents and redundant equations.

Identifying this explicit quotient with
  Ω[(K[z]/I)/K] ⊗_(K[z]/I) K
is the remaining conormal exact-sequence/base-change
naturality theorem; this module does not claim it.
-/

open scoped BigOperators

namespace Deligne21D

/-- An actual relation vector: the gradient of a lifted
defining polynomial of U^k, evaluated at the chosen point. -/
noncomputable def conormalRow
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u : Deligne16.Coord k s → K)
    (t : Deligne16.EqCoord k r) :
    Deligne16.Coord k s → K :=
  fun i => MvPolynomial.eval u
    (MvPolynomial.pderiv i (Deligne16.copyEquation f t))

/-- The conormal subspace in K^(ks) generated by the actual
polynomial Jacobian rows. -/
noncomputable def conormalRelations
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u : Deligne16.Coord k s → K) :
    Subspace K (Deligne16.Coord k s → K) :=
  Submodule.span K (Set.range (conormalRow f u))

/-- The explicit presented cotangent fiber of the affine
product's polynomial Jacobian at u. Its isomorphism with the
base-changed Kähler module is a separately recorded target. -/
abbrev presentedCotangentFiber
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u : Deligne16.Coord k s → K) :=
  (Deligne16.Coord k s → K) ⧸ conormalRelations f u

/-- A finite-coordinate covector vanishes on the entire conormal
row span exactly when its coordinate vector annihilates every
actual polynomial derivative row, as in DEL-20. -/
theorem dual_annihilator_iff_jacobian_tangent
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u v : Deligne16.Coord k s → K) :
    ((LinearEquiv.piRing K K (Deligne16.Coord k s) K).symm v :
      Module.Dual K (Deligne16.Coord k s → K)) ∈
      (conormalRelations f u).dualAnnihilator ↔
      v ∈ Deligne20.jacobianTangent f u := by
  classical
  rw [Submodule.mem_dualAnnihilator]
  constructor
  · intro h
    apply (Deligne20.mem_jacobianTangent_iff f u v).mpr
    intro t
    have hrow : conormalRow f u t ∈ conormalRelations f u :=
      Submodule.subset_span (Set.mem_range_self t)
    have hz := h (conormalRow f u t) hrow
    simpa only [LinearEquiv.piRing_symm_apply, smul_eq_mul,
      conormalRow] using hz
  · intro hv
    have ht :
        ∀ t : Deligne16.EqCoord k r,
          (∑ i : Deligne16.Coord k s, conormalRow f u t i * v i) = 0 :=
      (Deligne20.mem_jacobianTangent_iff f u v).mp hv
    have hker :
        conormalRelations f u ≤
          LinearMap.ker
            ((LinearEquiv.piRing K K (Deligne16.Coord k s) K).symm v) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨t, rfl⟩
      change ((LinearEquiv.piRing K K (Deligne16.Coord k s) K).symm v)
        (conormalRow f u t) = 0
      simpa only [LinearEquiv.piRing_symm_apply, smul_eq_mul] using ht t
    intro w hw
    exact hker hw

/-- The dual annihilator, represented as ambient coordinate
vectors using the true finite-dimensional coordinate-dual
equivalence, is exactly DEL-20's Jacobian tangent subspace. -/
theorem dual_annihilator_comap_eq_tangent
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u : Deligne16.Coord k s → K) :
    (conormalRelations f u).dualAnnihilator =
      (Deligne20.jacobianTangent f u).comap
        (LinearEquiv.piRing K K (Deligne16.Coord k s) K).toLinearMap := by
  classical
  let E := LinearEquiv.piRing K K (Deligne16.Coord k s) K
  ext phi
  change phi ∈ (conormalRelations f u).dualAnnihilator ↔
      E phi ∈ Deligne20.jacobianTangent f u
  simpa only [E, LinearEquiv.symm_apply_apply] using
    (dual_annihilator_iff_jacobian_tangent f u (E phi))

/-- The actual presented cotangent module is canonically dual to
the genuine DEL-20 Jacobian tangent, in all characteristics.
This is a linear equivalence of K-vector spaces. -/
noncomputable def presentedCotangentDualEquivTangent
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u : Deligne16.Coord k s → K) :
    Module.Dual K (presentedCotangentFiber f u) ≃ₗ[K]
      Deligne20.jacobianTangent f u := by
  classical
  let E := LinearEquiv.piRing K K (Deligne16.Coord k s) K
  exact ((conormalRelations f u).dualQuotEquivDualAnnihilator).trans
    ((LinearEquiv.ofEq _ _ (dual_annihilator_comap_eq_tangent f u)).trans
      (E.ofSubmodule' (Deligne20.jacobianTangent f u)))

/-- An equivalent existence theorem useful for composing with
the real conormal sequence when that identification is added:
every tangent vector comes from a unique dual covector of the
presented cotangent fiber. -/
theorem exists_unique_cotangent_functional
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (u : Deligne16.Coord k s → K)
    (v : Deligne20.jacobianTangent f u) :
    ∃! phi : Module.Dual K (presentedCotangentFiber f u),
      presentedCotangentDualEquivTangent f u phi = v := by
  let e := presentedCotangentDualEquivTangent f u
  refine ⟨e.symm v, e.apply_symm_apply v, ?_⟩
  intro phi h
  exact e.injective (h.trans (e.apply_symm_apply v).symm)

#print axioms dual_annihilator_iff_jacobian_tangent
#print axioms dual_annihilator_comap_eq_tangent
#print axioms presentedCotangentDualEquivTangent
#print axioms exists_unique_cotangent_functional

end Deligne21D
