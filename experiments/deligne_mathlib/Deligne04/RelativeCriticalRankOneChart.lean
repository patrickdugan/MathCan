import Deligne04.UniversalRelativeCritical
import Mathlib.Tactic

/-!
# DEL-22B: relative critical minors on a nonvanishing rank-one chart

If the original conormal space is generated by one true Jacobian row
with a nonzero pivot coefficient, the critical section condition is
equivalent to vanishing of its two-by-two pivot minors with the
section gradient. The hypothesis is explicit: at lower rank, or where
the pivot vanishes, this chart cannot be used.
-/

open TensorProduct Module
open scoped BigOperators

namespace Deligne22B

/-- A finite family g is in the span of a single row r with a nonzero
pivot precisely if every 2×2 pivot minor vanishes. This is the
rank-one determinant converse in the actual nonzero-pivot chart. -/
theorem mem_span_singleton_iff_pivot_minors
    {L : Type*} [Field L]
    {ι : Type*} [Fintype ι]
    (row g : ι → L) (pivot : ι) (hp : row pivot ≠ 0) :
    g ∈ Submodule.span L ({row} : Set (ι → L)) ↔
      ∀ j : ι, row pivot * g j - g pivot * row j = 0 := by
  classical
  rw [Submodule.mem_span_singleton]
  constructor
  · rintro ⟨lam, hlam⟩ j
    have h0 := congrArg (fun x : ι → L => x pivot) hlam
    have hj := congrArg (fun x : ι → L => x j) hlam
    simp only [Pi.smul_apply, smul_eq_mul] at h0 hj
    rw [← hj, ← h0]
    ring
  · intro h
    refine ⟨g pivot / row pivot, ?_⟩
    funext j
    simp only [Pi.smul_apply, smul_eq_mul]
    have hj : row pivot * g j = g pivot * row j :=
      sub_eq_zero.mp (h j)
    calc
      (g pivot / row pivot) * row j =
          (g pivot * row j) / row pivot := div_mul_eq_mul_div _ _ _
      _ = g j := (div_eq_iff hp).mpr (by
        calc
          g pivot * row j = row pivot * g j := hj.symm
          _ = g j * row pivot := mul_comm _ _)

/-- On a genuine original-conormal rank-one chart with pivot ≠ 0,
relative criticality of the actual DEL-16 section is equivalent to
the two-by-two determinantal equations for each source coordinate. -/
theorem criticalOnTangent_iff_pivot_minors
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (B : MvPolynomial (Deligne16.Coord k s) K)
    (a : Deligne16.Coord k s → K) (c : K)
    (u : Deligne16.Coord k s → L)
    (row : Deligne16.Coord k s → L)
    (pivot : Deligne16.Coord k s)
    (hspan : Deligne21G.geometricConormalRelations f u =
       Submodule.span L ({row} : Set (Deligne16.Coord k s → L)))
    (hp : row pivot ≠ 0) :
    Deligne22A.criticalOnTangent f B a c u ↔
      Deligne21G.onGeometricProduct f u ∧
        MvPolynomial.aeval u (Deligne16.fixedSection B a c) = 0 ∧
        ∀ j : Deligne16.Coord k s,
          row pivot * Deligne22A.sectionGradient B a c u j -
            Deligne22A.sectionGradient B a c u pivot * row j = 0 := by
  rw [Deligne22A.criticalOnTangent_iff_conormal]
  constructor
  · rintro ⟨hpt, hs, hg⟩
    refine ⟨hpt, hs, ?_⟩
    rw [hspan] at hg
    exact (mem_span_singleton_iff_pivot_minors row
      (Deligne22A.sectionGradient B a c u) pivot hp).mp hg
  · rintro ⟨hpt, hs, hminors⟩
    refine ⟨hpt, hs, ?_⟩
    rw [hspan]
    exact (mem_span_singleton_iff_pivot_minors row
      (Deligne22A.sectionGradient B a c u) pivot hp).mpr hminors

/-- Original polynomial 2×2 determinant for a chosen original
Jacobian row and the actual section derivative, with fixed parameters. -/
noncomputable def pivotMinorPolynomial
    {K : Type*} [Field K] {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (B : MvPolynomial (Deligne16.Coord k s) K)
    (a : Deligne16.Coord k s → K) (c : K)
    (t : Deligne16.EqCoord k r)
    (pivot j : Deligne16.Coord k s) :
    MvPolynomial (Deligne16.Coord k s) K :=
  MvPolynomial.pderiv pivot (Deligne16.copyEquation f t) *
    MvPolynomial.pderiv j (Deligne16.fixedSection B a c) -
  MvPolynomial.pderiv pivot (Deligne16.fixedSection B a c) *
    MvPolynomial.pderiv j (Deligne16.copyEquation f t)

/-- The actual polynomial pivot minor evaluates to the finite-field
two-by-two rank-one determinant of original Jacobian and section rows. -/
theorem aeval_pivotMinorPolynomial
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (B : MvPolynomial (Deligne16.Coord k s) K)
    (a : Deligne16.Coord k s → K) (c : K)
    (u : Deligne16.Coord k s → L)
    (t : Deligne16.EqCoord k r)
    (pivot j : Deligne16.Coord k s) :
    MvPolynomial.aeval u (pivotMinorPolynomial f B a c t pivot j) =
      Deligne21G.geometricConormalRow f u t pivot *
        Deligne22A.sectionGradient B a c u j -
      Deligne22A.sectionGradient B a c u pivot *
        Deligne21G.geometricConormalRow f u t j := by
  simp [pivotMinorPolynomial, Deligne22A.sectionGradient,
    Deligne21G.geometricConormalRow]

/-- Rank-one smooth-chart criticality is exactly the original
polynomial pivot-minor vanishing condition (with section and
on-scheme equations), for every field extension. -/
theorem criticalOnTangent_iff_pivotPolynomial_zero
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    {k s r : ℕ}
    (f : Fin r → MvPolynomial (Fin s) K)
    (B : MvPolynomial (Deligne16.Coord k s) K)
    (a : Deligne16.Coord k s → K) (c : K)
    (u : Deligne16.Coord k s → L)
    (t : Deligne16.EqCoord k r)
    (pivot : Deligne16.Coord k s)
    (hspan : Deligne21G.geometricConormalRelations f u =
       Submodule.span L ({Deligne21G.geometricConormalRow f u t} :
         Set (Deligne16.Coord k s → L)))
    (hp : Deligne21G.geometricConormalRow f u t pivot ≠ 0) :
    Deligne22A.criticalOnTangent f B a c u ↔
      Deligne21G.onGeometricProduct f u ∧
        MvPolynomial.aeval u (Deligne16.fixedSection B a c) = 0 ∧
        ∀ j : Deligne16.Coord k s,
          MvPolynomial.aeval u (pivotMinorPolynomial f B a c t pivot j) = 0 := by
  rw [criticalOnTangent_iff_pivot_minors f B a c u
    (Deligne21G.geometricConormalRow f u t) pivot hspan hp]
  simp only [aeval_pivotMinorPolynomial]

#print axioms mem_span_singleton_iff_pivot_minors
#print axioms criticalOnTangent_iff_pivot_minors
#print axioms aeval_pivotMinorPolynomial
#print axioms criticalOnTangent_iff_pivotPolynomial_zero

end Deligne22B
