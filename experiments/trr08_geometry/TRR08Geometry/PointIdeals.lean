module

public import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point

@[expose] public section

/-!
# The actual affine point ideal cannot have one generator

Mathlib constructs the affine coordinate ring, its fraction field, and the
injective map from nonsingular Weierstrass points to its ideal class group.
This corollary applies that construction directly to the ideal of a finite
point. Relating a global divisor of a rational function to this affine ideal
is a separate geometric step in the matching-characteristic argument.
-/

namespace TRR08Geometry

open WeierstrassCurve

variable {K : Type*} [Field K] [DecidableEq K] {W : Affine K}

/-- A nonidentity point has a nonzero class in the actual affine class group. -/
theorem nonidentity_point_class_ne_zero (P : W.Point) (hP : P ≠ 0) :
    Affine.Point.toClass P ≠ 0 := by
  intro hc
  exact hP ((Affine.Point.toClass_eq_zero P).mp hc)

/-- The ideal generated by the two coordinate differences at a nonsingular
finite point cannot be the ideal of a single nonzero coordinate-ring element. -/
theorem point_ideal_ne_single_generator {x y : K} (h : W.Nonsingular x y)
    (z : W.CoordinateRing) (hz : z ≠ 0) :
    Affine.CoordinateRing.XYIdeal W x (Polynomial.C y) ≠ Ideal.span {z} := by
  intro he
  have hc : Affine.Point.toClass (Affine.Point.some x y h) = 0 := by
    change ClassGroup.mk W.FunctionField
      (Affine.CoordinateRing.XYIdeal' (W := W) h) = 1
    exact (ClassGroup.mk_eq_one_of_coe_ideal (by rfl)).mpr ⟨z, hz, he⟩
  exact nonidentity_point_class_ne_zero _ (Affine.Point.some_ne_zero h) hc

end TRR08Geometry

#print axioms TRR08Geometry.nonidentity_point_class_ne_zero
#print axioms TRR08Geometry.point_ideal_ne_single_generator
