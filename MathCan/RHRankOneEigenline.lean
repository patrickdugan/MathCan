import Init

/-!
# RHD-10: Init-only algebraic rank-one eigenfamily

This theorem isolates the multiplicative character / right-translation
calculation using integer-valued functions, so it can be checked inside
MathCan's actual Init-only Lean 4.35 project. The target remains the
complex-valued adelic automorphic U in the pinned upstream source.
This standalone finite algebraic model does not construct that U.
-/

namespace MathCan.RHRankOneEigenline

universe u
variable {G : Type u}

/-- A scalar-valued abstract character function. -/
def characterFunction (χ : G → Int) : G → Int := χ

/-- Right translation for a supplied multiplication on G. -/
def rightTranslate (mulG : G → G → G) (h : G)
    (f : G → Int) : G → Int :=
  fun g => f (mulG g h)

/-- The integer scalar-multiple family generated by χ. -/
def eigenfamily (χ : G → Int) (f : G → Int) : Prop :=
  ∃ c : Int, f = fun g => c * χ g

theorem character_mem_eigenfamily (χ : G → Int) :
    eigenfamily χ (characterFunction χ) := by
  refine ⟨1, ?_⟩
  funext g
  simp [characterFunction]

theorem character_nonzero (e : G) (χ : G → Int)
    (hunit : χ e = 1) :
    characterFunction χ ≠ (fun _ => (0 : Int)) := by
  intro h
  have he := congrArg (fun f : G → Int => f e) h
  simp [characterFunction, hunit] at he

theorem character_right_eigen
    (mulG : G → G → G) (χ : G → Int)
    (hmul : ∀ g h, χ (mulG g h) = χ g * χ h) (h : G) :
    rightTranslate mulG h (characterFunction χ) =
      fun g => χ h * characterFunction χ g := by
  funext g
  simp [rightTranslate, characterFunction, hmul, Int.mul_comm]

theorem eigenfamily_right_eigen
    (mulG : G → G → G) (χ : G → Int)
    (hmul : ∀ g h, χ (mulG g h) = χ g * χ h)
    (h : G) (f : G → Int) (hf : eigenfamily χ f) :
    rightTranslate mulG h f = fun g => χ h * f g := by
  rcases hf with ⟨c, rfl⟩
  funext g
  simp [rightTranslate, hmul, Int.mul_comm, Int.mul_left_comm, Int.mul_assoc]

theorem eigenfamily_right_invariant
    (mulG : G → G → G) (χ : G → Int)
    (hmul : ∀ g h, χ (mulG g h) = χ g * χ h)
    (h : G) (f : G → Int) (hf : eigenfamily χ f) :
    eigenfamily χ (rightTranslate mulG h f) := by
  rcases hf with ⟨c, rfl⟩
  refine ⟨χ h * c, ?_⟩
  funext g
  simp [rightTranslate, hmul, Int.mul_comm, Int.mul_left_comm, Int.mul_assoc]

theorem nonzero_right_eigenvector
    (mulG : G → G → G) (e : G) (χ : G → Int)
    (hmul : ∀ g h, χ (mulG g h) = χ g * χ h)
    (hunit : χ e = 1) :
    ∃ f : G → Int, eigenfamily χ f ∧
      f ≠ (fun _ => (0 : Int)) ∧
      ∀ h, rightTranslate mulG h f = fun g => χ h * f g := by
  exact ⟨characterFunction χ, character_mem_eigenfamily χ,
    character_nonzero e χ hunit,
    character_right_eigen mulG χ hmul⟩

/-- The safe finite shadow of the exceptional-place index condition. -/
def otherRamified (w₀ w : Fin 4) : Prop := w ≠ w₀

theorem selected_place_excluded (w₀ : Fin 4) :
    ¬ otherRamified w₀ w₀ := by
  simp [otherRamified]

theorem other_place_included (w₀ w : Fin 4) (h : w ≠ w₀) :
    otherRamified w₀ w := h

/-- An explicit, decidable finite count of the three other indices. -/
def exceptionalCount (w₀ : Fin 4) : Nat :=
  ((List.finRange 4).filter (fun w => decide (otherRamified w₀ w))).length

theorem three_exceptional_places (w₀ : Fin 4) :
    exceptionalCount w₀ = 3 := by
  rcases w₀ with ⟨n, hn⟩
  have h : n = 0 ∨ n = 1 ∨ n = 2 ∨ n = 3 := by omega
  rcases h with h | h | h | h <;> subst n <;> decide

#print axioms character_mem_eigenfamily
#print axioms character_nonzero
#print axioms character_right_eigen
#print axioms eigenfamily_right_eigen
#print axioms eigenfamily_right_invariant
#print axioms nonzero_right_eigenvector
#print axioms three_exceptional_places

end MathCan.RHRankOneEigenline
